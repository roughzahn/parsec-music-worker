FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 TZ=Europe/Berlin
RUN apt-get update -qq && apt-get install -y -qq ffmpeg tzdata && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-common.txt .
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.7.1 \
    && pip install --no-cache-dir -r requirements-common.txt
COPY worker ./worker
CMD ["python", "-m", "worker.main"]

# URL must be reachable from inside the worker container.
# CPU development may use http://host.docker.internal:8766.
# GPU pairing must use the HTTPS Caddy endpoint (for example https://your-gateway-hostname).
PARSEC_GATEWAY_BASE_URL=http://host.docker.internal:8766
PARSEC_WORKER_TOKEN=replace-with-the-private-gateway-token  # CPU only; GPU uses Admin pairing and needs no token
PARSEC_WORKER_ID=windows-cpu-01
# Windows example: C:/parsec/models
PARSEC_MODEL_PATH=C:/parsec/models
PARSEC_WORKER_HEALTH_PORT=8081

# Pin to a released version (for example 0.1.0); latest tracks the newest release.
PARSEC_WORKER_VERSION=0.1.0

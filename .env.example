# URL must be reachable from inside the worker container.
# Docker Desktop: http://host.docker.internal:8766
# vServer: use the Gateway's private Docker service name or its reachable public URL.
PARSEC_GATEWAY_BASE_URL=http://host.docker.internal:8766
PARSEC_WORKER_TOKEN=replace-with-the-private-gateway-token
PARSEC_WORKER_ID=windows-gpu-01
# Windows example: C:/parsec/models
PARSEC_MODEL_PATH=C:/parsec/models

# Pin to a released version (for example 0.1.0); latest tracks the newest release.
PARSEC_WORKER_VERSION=latest
